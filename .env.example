# DeepSeek API 配置
DEEPSEEK_API_KEY=your-deepseek-api-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-v4-flash

# JWT 签名密钥（请生成一个随机字符串替换）
JWT_SECRET=change-me-to-a-random-string-64-chars

# 服务端口
PORT=3002

# 允许的来源域名（逗号分隔）
# 校验方式为严格 host 匹配：精确域名或子域名，不支持子串包含。
ALLOWED_ORIGINS=chieko3020.xyz,chieko3020.cn,www.chieko3020.xyz,www.chieko3020.cn

# 语义敏感词兜底（可选，默认空 = 不启用），逗号分隔的正则片段
# 仅作关键词兜底；正则拦不住变形/谐音/多轮绕过，内容合规主要靠下面的输出审核。
SENSITIVE_PATTERNS=

# ── 输出侧语义审核（LLM as judge）───────────────────────────────
# DeepSeek 没有 moderation 端点，这里用一次 flash 判别调用实现：
#   MODERATION_URL 指向 chat/completions，模型返回 {"allow":..,"category":..}
#
# ⚠️ 不要指向本机 ai-gateway：它是语义缓存网关，会把"相似" prompt 判为同一请求
#    并复用答案，实测出现过"违规样本命中缓存的 allow=true 而放行"。
#
# 默认开启。判定超时/报错/不可解析时按 fail-open 放行（可改 closed）。
MODERATION_ENABLED=1
MODERATION_URL=https://api.deepseek.com/v1/chat/completions
MODERATION_MODEL=deepseek-flash
MODERATION_TIMEOUT_SEC=8
MODERATION_MAX_TOKENS=256
MODERATION_FAIL_MODE=open
